# Environment variables subseer reads. It does not load this file itself:
# copy it to .env, fill it in, then `source .env` (or export them in your shell).

# Required for --gpt with OpenAI (not for --ollama or a keyless --api-base).
export OPENAI_API_KEY=sk-...

# Optional
# export SUBSEER_WORDLIST=/path/to/wordlist.txt   # default Fuzz wordlist
# export SUBSEER_LOG_DIR=~/.subseer               # where logs.jsonl is written
# export SUBSEER_OPENAI_RETRIES=8                 # retries for rate limits / errors
# export SUBSEER_OPENAI_BACKOFF=0.5               # first retry wait, in seconds
# export NO_COLOR=1                               # plain output, no colors
